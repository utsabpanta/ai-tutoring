# --- LLM ---
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
MODERATION_MODEL=llama-guard3:1b

# --- API ---
API_PORT=8787
WEB_ORIGIN=http://localhost:3000

# --- Local-dev defaults (the docker stack overrides these in docker-compose.yml) ---
# When running `pnpm dev` natively, ollama serves on localhost and the SQLite
# file lives next to the server.
OLLAMA_HOST=http://localhost:11434
DB_PATH=./data/tutor.db

# --- Dev user (auth bypass for v1) ---
DEV_USER_ID=dev
DEV_USER_GRADE_BAND=6-8
DEV_USER_TIMEZONE=America/Los_Angeles

# --- Usage caps (defaults; per-band overrides in code) ---
DAILY_MESSAGE_CAP_K5=50
DAILY_MESSAGE_CAP_K12=100
DAILY_MESSAGE_CAP_HIGHER_ED=200
SESSION_MINUTES_CAP_K12=90

# --- Quiet hours per band (HH in local timezone, 24h) ---
QUIET_HOURS_K5_START=20
QUIET_HOURS_K5_END=06
QUIET_HOURS_MS_START=21
QUIET_HOURS_MS_END=06
QUIET_HOURS_HS_START=22
QUIET_HOURS_HS_END=06

# --- Performance ---
LLM_TIMEOUT_MS=30000
GUARDRAIL_TIMEOUT_MS=2000
